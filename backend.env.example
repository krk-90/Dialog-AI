# Dialog AI backend environment
# Copy this file to .env for local development. Never commit real credentials.

# Required only for live Deepgram transcription.
DEEPGRAM_API_KEY=

# Optional: without a key, the API uses built-in coaching guidance.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173
