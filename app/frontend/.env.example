# Leave blank to use the Vite development proxy.
# For a separately deployed frontend, set this to the backend origin, e.g. https://your-api.onrender.com
# Never put Deepgram or Groq secrets in VITE_ variables.
VITE_API_BASE_URL=

# Optional Supabase Auth and cloud call history. The anon key is public by design; never use service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
