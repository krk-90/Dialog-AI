# Dialog AI backend environment
# Copy this file to .env for local development. Never commit real credentials.
# Local .env loading is supported by python-dotenv.

# Required only for live Deepgram transcription. Leave blank to use manual transcript mode.
DEEPGRAM_API_KEY=

# Required only for AI-generated coaching. Leave blank to use built-in coaching fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173

# Local SQLite database file. Keep the database out of Git.
DIALOG_AI_DB_PATH=data/dialog-ai.sqlite3

# Optional Supabase cloud call history. Use the public anon key, never a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
